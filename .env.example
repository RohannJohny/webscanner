# Copy this file to `.env` and fill in real values. Never commit the real `.env` file.

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login credentials for the scanner UI.
AUTH_USERNAME=admin

# Generate the hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password-here'))"
AUTH_PASSWORD_HASH=

# Optional: comma-separated list of hosts allowed to be scanned.
# Leave blank to allow any target (fine for local-only use; set this before
# putting the app anywhere public).
ALLOWED_TARGETS=127.0.0.1

# Blocks link-local addresses (incl. cloud metadata IP 169.254.169.254) by
# default — always on, not configurable, since there's no legitimate reason
# to scan them. Set this to "true" to ALSO block private/loopback ranges
# (127.x, 192.168.x, 10.x, etc.) unless the target is explicitly listed in
# ALLOWED_TARGETS above. Recommended "true" for any cloud/public deployment;
# leave "false" for normal local/LAN use.
STRICT_SSRF_GUARD=false

# Set to "false" only if you are running plain HTTP locally without TLS.
# Keep "true" (default) for any real deployment behind HTTPS.
COOKIE_SECURE=true

# Only ever "true" for local development. Never enable in production —
# Flask's debugger can execute arbitrary code if reachable.
FLASK_DEBUG=false
